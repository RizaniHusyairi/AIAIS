  "faqs": [
    {
      "category": "Penerbangan & Keberangkatan",
      "question": "Apa saja rute penerbangan yang tersedia di Bandara A.P.T. Pranoto Samarinda?",
      "answer": "Bandara A.P.T. Pranoto Samarinda melayani penerbangan menuju Jakarta, Surabaya, Yogyakarta, Banjarmasin, Berau, dan Melak. Selain itu tersedia rute penerbangan perintis menuju Long Apung, Maratua, Datah Dawai, dan Muara Wahau, serta koneksi antarwilayah Datah Dawai–Melak dan Maratua–Berau."
    },
    {
      "category": "Fasilitas Bandara",
      "question": "Apakah bandara menyediakan fasilitas bagi penyandang disabilitas?",
      "answer": "Ya. Bandara menyediakan fasilitas ramah disabilitas seperti jalur khusus, toilet difabel, area parkir khusus, dan layanan bantuan sesuai kebutuhan. Penumpang dapat menghubungi petugas atau Customer Service setibanya di bandara maupun sebelum keberangkatan, agar petugas dapat memberikan pendampingan dan bantuan sesuai kebutuhan."
    },
    {
      "category": "Layanan & Perizinan",
      "question": "Apakah Bandara A.P.T. Pranoto Samarinda menyediakan layanan kargo?",
      "answer": "Ya. Bandara A.P.T. Pranoto Samarinda memiliki Gedung Kargo Lini 2 yang melayani kegiatan Ekspedisi Muatan Pesawat Udara (EMPU). Layanan kargo beroperasi setiap hari pada pukul 08.00–17.00 WITA dan didukung oleh beberapa perusahaan kargo untuk melayani kebutuhan pengiriman barang melalui transportasi udara, termasuk informasi terkait tarif, pengiriman, dan jenis layanan."
    },
    {
      "category": "Informasi Publik & Pengaduan",
      "question": "Bagaimana cara mengajukan pengaduan atau saran?",
      "answer": "Pengaduan dan saran dapat disampaikan melalui: Media sosial resmi bandara WhatsApp pengaduan: +62 811-551-944 Website resmi bandara Kotak saran yang tersedia di terminal SP4N-LAPOR!"
    },
    {
      "category": "Penerbangan & Keberangkatan",
      "question": "Berapa jam operasional Bandara A.P.T. Pranoto?",
      "answer": "Jam operasional Bandara A.P.T. Pranoto mengikuti jadwal operasional yang telah ditetapkan, yaitu pukul 07.00 WITA hingga 20.00 WITA."
    },
    {
      "category": "Fasilitas Bandara",
      "question": "Bagaimana jika saya kehilangan barang di bandara?",
      "answer": "Segera hubungi petugas Lost and Found atau Pusat Informasi bandara, atau kontak resmi bandara, dengan menyampaikan ciri-ciri barang, lokasi terakhir, dan waktu kehilangan."
    }
