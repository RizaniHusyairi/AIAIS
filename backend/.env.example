APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Versi produk. Kosongkan agar dibaca dari berkas VERSION di akar monorepo.
# Isi hanya bila backend dideploy terpisah tanpa akar repo.
APP_VERSION=

# Versi KONTRAK API (prefiks /api/<versi>). Bukan versi produk —
# naikkan hanya saat bentuk data berubah dan merusak klien lama.
API_VERSION=v2


APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Migrasi data portal v1 (aptpairport.id) — hanya dipakai command aiais:import-*
# Arahkan ke hasil restore dump PRODUKSI, bukan salinan pengembangan `db_apt`.
LEGACY_DB_DATABASE=db_apt_prod
LEGACY_UPLOADS_PATH=
LEGACY_DUMP_TAKEN_AT=

# Masa berlaku token panel (menit). 480 = 8 jam kerja.
SANCTUM_EXPIRATION=480

# Alamat portal (Next.js) — dipakai menyusun tautan dalam surel.
FRONTEND_URL=http://localhost:3000
