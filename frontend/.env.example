# Salin menjadi .env.local, lalu sesuaikan.
# Berkas .env.local diabaikan git; berkas contoh ini yang terkomit.

# --- Alamat API backend ---------------------------------------------------
# Cara biasa: cukup isi asal servernya, prefiks versi disusun otomatis
# dari NEXT_PUBLIC_API_VERSION di bawah.
NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:8000

# Versi KONTRAK API — harus sama dengan API_VERSION di backend/.env.
# Ini BUKAN versi produk (versi produk ada di berkas VERSION akar repo).
NEXT_PUBLIC_API_VERSION=v2

# Override URL penuh. Menang atas kedua nilai di atas.
# Dipakai saat mengakses dari perangkat lain di LAN:
# NEXT_PUBLIC_API_URL=http://10.10.20.226:8000/api/v2

# --- Versi produk ---------------------------------------------------------
# Kosongkan. Nilainya dibaca otomatis dari <akar repo>/VERSION oleh
# next.config.ts. Isi hanya bila frontend dibangun terpisah tanpa akar repo.
# NEXT_PUBLIC_APP_VERSION=

# --- Peta rute penerbangan ------------------------------------------------
# Kosongkan agar peta memakai garis pantai lokal (tanpa internet).
# Lihat src/lib/mapTiles.ts sebelum mengisi.
# NEXT_PUBLIC_MAP_TILE_URL=
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
# NEXT_PUBLIC_MAP_TILE_MAXZOOM=10
