# Dependencies
node_modules/
backend/vendor/

# Next.js build outputs
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/

# Environment files & secret keys (CRITICAL)
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
backend/.env
backend/.env.backup
backend/.env.production

# Laravel Storage & Cache
backend/storage/*.key
backend/storage/logs/*
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/bootstrap/cache/*
!backend/storage/logs/.gitkeep
!backend/storage/framework/cache/.gitkeep
!backend/storage/framework/sessions/.gitkeep
!backend/storage/framework/views/.gitkeep
!backend/bootstrap/cache/.gitkeep

# IDEs & System files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
*.log

# Temporary test / brain output
brain/
scratch/

# Data pribadi pegawai (CRITICAL — jangan pernah masuk riwayat git)
#
# Rekap kepegawaian memuat NIK, NIP, ID BKN, Karpeg, agama, alamat rumah,
# email, dan nomor ponsel 128 pegawai. Agama termasuk data pribadi bersifat
# spesifik menurut UU 27/2022 Pasal 4 ayat (2).
#
# Yang boleh terbit dari berkas itu hanya nama, jabatan, dan unit kerja —
# ketiganya sudah disalin ke frontend/src/lib/pegawai.ts. Berkas mentahnya
# tidak punya alasan untuk ada di repositori. Sekali ter-commit, ia ada
# selamanya di riwayat meski berkasnya dihapus belakangan.
docs/Daftar Pegawai.xlsx
docs/*.xlsx

# Perkakas Claude Code. Isinya konfigurasi per-mesin: .claude/launch.json memuat
# lintasan absolut mesin pengembang, dan .claude/settings.local.json selama ini
# hanya terlindung oleh ignore global di mesin ini — kolaborator lain tidak
# punya perlindungan itu. Skill dan agent disalin manual antar mesin.
.claude/
.agents/
skills-lock.json

# Aset sumber dan referensi desain. Yang benar-benar dilayani ke pengunjung ada
# di frontend/public/; berkas mentah di bawah ini hanya membesarkan kloning
# tanpa pernah dibaca kode.
logo aplikasi/
docs/UI/
frontend/logo/

# Dump dan ekspor basis data. Portal berjalan di atas basis data produksi v1;
# satu dump yang tak sengaja ter-commit berarti seluruh isi portal — termasuk
# identitas pemohon informasi dan pelapor kehilangan — ada selamanya di riwayat
# git, meski berkasnya dihapus belakangan.
*.sql
*.sql.gz
*.dump
*.sqlite
*.sqlite3

# Arsip dan berkas tabel di docs/. Rekap kepegawaian sudah disebut di atas,
# tetapi ekspor laporan berikutnya belum tentu bernama sama.
docs/*.xls
docs/*.csv
*.zip
*.rar
*.7z

# Kunci dan sertifikat
*.pem
*.key
*.p12

# Konfigurasi konektor MCP per-mesin (lihat CLAUDE.md: berkas .claude/ dan
# konfigurasi mesin tidak ikut repositori)
.mcp.json
